@app.route('/logs')
def view_logs():
    try:
        with open('clicks_data.jsonl', 'r', encoding='utf-8') as f:
            lines = f.readlines()
            logs = [json.loads(line) for line in lines[-20:]]  # últimos 20
        return jsonify(logs)
    except:
        return jsonify([])

